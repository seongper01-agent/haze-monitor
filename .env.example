# Supabase credentials (copy this to .env and fill in)
# Vercel: inject these as environment variables in project settings

# Public (safe for frontend/Vercel env vars)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Secret (collector only — never commit or put in Vercel public env)
SUPABASE_SERVICE_ROLE_KEY=eyJ...